      p_params => g_params,
      p_trace_level => g_trace_level,
      p_trace_context => g_context);
      
    pit_call_stack.long_op(
      p_target => 'UnitTest',
      p_sofar => 50,
      p_total => 100,
      p_units => 'Ticks',
      p_op_name => 'FOO.MY_FUNCTION');
      
    open l_cursor for 
      select *
        from v$session_longops
       where sid = sys_context('USERENV', 'SID')
         and sofar = 50
         and totalwork = 100;
    ut.expect(l_cursor).not_to_be_empty;
  end long_op;
  
